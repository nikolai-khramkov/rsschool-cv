{
  "languages": {
    "Vue.js": {
      "formatter": [
        { "code_action": "source.fixAll.eslint" }
      ],
      "format_on_save": "on",
      "tab_size": 2
    },
    "TypeScript": {
      "formatter": [
        { "code_action": "source.fixAll.eslint" }
      ],
      "format_on_save": "on",
      "tab_size": 2
    },
    "JavaScript": {
      "formatter": [
        { "code_action": "source.fixAll.eslint" }
      ],
      "format_on_save": "on",
      "tab_size": 2
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    }
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "vue": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            ":class=\"([^\"]*)\"",
            ":class='([^']*)'"
          ]
        }
      }
    }
  },

  "semantic_tokens": "combined",
}
